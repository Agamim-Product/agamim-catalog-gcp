{
  "name": "pl_ingest_flydata",
  "properties": {
    "description": "data.gov.il flydata: API -> lake (bronze, unchanged) -> silver (English columns only + Tel Aviv ingest time, done by the Copy step) -> SQL step types the times, runs the checks and replaces gold.flights. Rows are paged 1,000 at a time, up to 50,000.",
    "activities": [
      {
        "name": "SetRunId",
        "type": "SetVariable",
        "dependsOn": [],
        "userProperties": [],
        "typeProperties": {
          "variableName": "runId",
          "value": {
            "value": "@formatDateTime(pipeline().TriggerTime, 'yyyyMMddHHmmss')",
            "type": "Expression"
          }
        }
      },
      {
        "name": "CopyPackageToLake",
        "type": "Copy",
        "dependsOn": [
          {
            "activity": "SetRunId",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:15:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "RestSource",
            "httpRequestTimeout": "00:02:00",
            "requestInterval": "00.00:00:00.200",
            "requestMethod": "GET",
            "additionalHeaders": {
              "User-Agent": "Mozilla/5.0 (compatible; open-data-catalog-ingest/0.1)"
            }
          },
          "sink": {
            "type": "JsonSink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings"
            },
            "formatSettings": {
              "type": "JsonWriteSettings"
            }
          },
          "enableStaging": false,
          "dataIntegrationUnits": 2
        },
        "inputs": [
          {
            "referenceName": "ds_ckan_rest",
            "type": "DatasetReference",
            "parameters": {
              "relativeUrl": {
                "value": "@concat('package_show?id=', pipeline().parameters.datasetName)",
                "type": "Expression"
              }
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_lake_json",
            "type": "DatasetReference",
            "parameters": {
              "folder": {
                "value": "@concat('ckan/package/dt=', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), '/run=', variables('runId'))",
                "type": "Expression"
              },
              "file": "package.json"
            }
          }
        ]
      },
      {
        "name": "CopyColumnsToLake",
        "type": "Copy",
        "dependsOn": [
          {
            "activity": "SetRunId",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:15:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "RestSource",
            "httpRequestTimeout": "00:02:00",
            "requestInterval": "00.00:00:00.200",
            "requestMethod": "GET",
            "additionalHeaders": {
              "User-Agent": "Mozilla/5.0 (compatible; open-data-catalog-ingest/0.1)"
            }
          },
          "sink": {
            "type": "JsonSink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings"
            },
            "formatSettings": {
              "type": "JsonWriteSettings"
            }
          },
          "enableStaging": false,
          "dataIntegrationUnits": 2
        },
        "inputs": [
          {
            "referenceName": "ds_ckan_rest",
            "type": "DatasetReference",
            "parameters": {
              "relativeUrl": {
                "value": "@concat('datastore_search?limit=0&resource_id=', pipeline().parameters.resourceId)",
                "type": "Expression"
              }
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_lake_json",
            "type": "DatasetReference",
            "parameters": {
              "folder": {
                "value": "@concat('ckan/datastore/dt=', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), '/run=', variables('runId'))",
                "type": "Expression"
              },
              "file": "fields.json"
            }
          }
        ]
      },
      {
        "name": "CopyRowsToLake",
        "type": "Copy",
        "dependsOn": [
          {
            "activity": "SetRunId",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "RestSource",
            "httpRequestTimeout": "00:02:00",
            "requestInterval": "00.00:00:00.200",
            "requestMethod": "GET",
            "additionalHeaders": {
              "User-Agent": "Mozilla/5.0 (compatible; open-data-catalog-ingest/0.1)"
            },
            "paginationRules": {
              "QueryParameters.{offset}": "RANGE:0:50000:1000",
              "EndCondition:$.result.records": "Empty"
            }
          },
          "sink": {
            "type": "JsonSink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings"
            },
            "formatSettings": {
              "type": "JsonWriteSettings"
            }
          },
          "enableStaging": false,
          "dataIntegrationUnits": 2
        },
        "inputs": [
          {
            "referenceName": "ds_ckan_rest",
            "type": "DatasetReference",
            "parameters": {
              "relativeUrl": {
                "value": "@concat('datastore_search?limit=', string(pipeline().parameters.pageSize), '&resource_id=', pipeline().parameters.resourceId, '&offset={offset}')",
                "type": "Expression"
              }
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_lake_json",
            "type": "DatasetReference",
            "parameters": {
              "folder": {
                "value": "@concat('ckan/records/dt=', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), '/run=', variables('runId'))",
                "type": "Expression"
              },
              "file": "records.json"
            }
          }
        ]
      },
      {
        "name": "CopyRowsToSilver",
        "type": "Copy",
        "dependsOn": [
          {
            "activity": "CopyRowsToLake",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:15:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [
          {
            "name": "CHOPER",
            "value": "→ airline_code: Airline code (IATA), e.g. LY"
          },
          {
            "name": "CHFLTN",
            "value": "→ flight_number: Flight number"
          },
          {
            "name": "CHOPERD",
            "value": "→ airline_name: Airline name"
          },
          {
            "name": "CHAORD",
            "value": "→ direction_code: Direction: A = arrival, D = departure (final table: arrival / departure)"
          },
          {
            "name": "CHSTOL",
            "value": "→ scheduled_at: Scheduled time, Israel time"
          },
          {
            "name": "CHPTOL",
            "value": "→ estimated_at: Estimated or actual time, Israel time"
          },
          {
            "name": "CHLOC1",
            "value": "→ airport_code: Airport code of the destination or origin (IATA)"
          },
          {
            "name": "CHLOC1D",
            "value": "→ airport_name: Airport name of the destination or origin"
          },
          {
            "name": "CHLOC1T",
            "value": "→ city_en: City of the destination or origin, in English"
          },
          {
            "name": "CHLOCCT",
            "value": "→ country_en: Country of the destination or origin, in English"
          },
          {
            "name": "CHTERM",
            "value": "→ terminal: Terminal number"
          },
          {
            "name": "CHCINT",
            "value": "→ checkin_counters: Check-in counters"
          },
          {
            "name": "CHCKZN",
            "value": "→ checkin_zone: Check-in zone"
          },
          {
            "name": "CHRMINE",
            "value": "→ status_en: Flight status, in English (e.g. LANDED, DEPARTED)"
          },
          {
            "name": "CHLOC1TH",
            "value": "not copied: City in Hebrew. Not copied"
          },
          {
            "name": "CHLOC1CH",
            "value": "not copied: Country in Hebrew. Not copied"
          },
          {
            "name": "CHRMINH",
            "value": "not copied: Flight status in Hebrew. Not copied"
          }
        ],
        "typeProperties": {
          "source": {
            "type": "JsonSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings",
              "recursive": false
            },
            "formatSettings": {
              "type": "JsonReadSettings"
            },
            "additionalColumns": [
              {
                "name": "ingested_at",
                "value": {
                  "value": "@formatDateTime(convertTimeZone(utcnow(), 'UTC', 'Israel Standard Time'), 'yyyy-MM-dd HH:mm:ss')",
                  "type": "Expression"
                }
              }
            ]
          },
          "sink": {
            "type": "AzureSqlSink",
            "preCopyScript": "TRUNCATE TABLE silver.flights_stage",
            "writeBehavior": "insert",
            "sqlWriterUseTableLock": false,
            "disableMetricsCollection": false
          },
          "enableStaging": false,
          "dataIntegrationUnits": 2,
          "translator": {
            "type": "TabularTranslator",
            "collectionReference": "$['result']['records']",
            "mappings": [
              {
                "source": {
                  "path": "['CHOPER']"
                },
                "sink": {
                  "name": "airline_code"
                }
              },
              {
                "source": {
                  "path": "['CHFLTN']"
                },
                "sink": {
                  "name": "flight_number"
                }
              },
              {
                "source": {
                  "path": "['CHOPERD']"
                },
                "sink": {
                  "name": "airline_name"
                }
              },
              {
                "source": {
                  "path": "['CHAORD']"
                },
                "sink": {
                  "name": "direction_code"
                }
              },
              {
                "source": {
                  "path": "['CHSTOL']"
                },
                "sink": {
                  "name": "scheduled_at"
                }
              },
              {
                "source": {
                  "path": "['CHPTOL']"
                },
                "sink": {
                  "name": "estimated_at"
                }
              },
              {
                "source": {
                  "path": "['CHLOC1']"
                },
                "sink": {
                  "name": "airport_code"
                }
              },
              {
                "source": {
                  "path": "['CHLOC1D']"
                },
                "sink": {
                  "name": "airport_name"
                }
              },
              {
                "source": {
                  "path": "['CHLOC1T']"
                },
                "sink": {
                  "name": "city_en"
                }
              },
              {
                "source": {
                  "path": "['CHLOCCT']"
                },
                "sink": {
                  "name": "country_en"
                }
              },
              {
                "source": {
                  "path": "['CHTERM']"
                },
                "sink": {
                  "name": "terminal"
                }
              },
              {
                "source": {
                  "path": "['CHCINT']"
                },
                "sink": {
                  "name": "checkin_counters"
                }
              },
              {
                "source": {
                  "path": "['CHCKZN']"
                },
                "sink": {
                  "name": "checkin_zone"
                }
              },
              {
                "source": {
                  "path": "['CHRMINE']"
                },
                "sink": {
                  "name": "status_en"
                }
              },
              {
                "source": {
                  "path": "['ingested_at']",
                  "type": "String"
                },
                "sink": {
                  "name": "ingested_at",
                  "type": "String"
                }
              }
            ]
          }
        },
        "inputs": [
          {
            "referenceName": "ds_lake_json",
            "type": "DatasetReference",
            "parameters": {
              "folder": {
                "value": "@concat('ckan/records/dt=', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), '/run=', variables('runId'))",
                "type": "Expression"
              },
              "file": "records.json"
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_sql_flights_stage",
            "type": "DatasetReference"
          }
        ],
        "description": "ETL in Data Factory: keep only the English columns, rename them, and add the ingest time in Tel Aviv time."
      },
      {
        "name": "ReadPackage",
        "type": "Lookup",
        "dependsOn": [
          {
            "activity": "CopyPackageToLake",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:15:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "JsonSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings",
              "recursive": false
            },
            "formatSettings": {
              "type": "JsonReadSettings"
            }
          },
          "dataset": {
            "referenceName": "ds_lake_json",
            "type": "DatasetReference",
            "parameters": {
              "folder": {
                "value": "@concat('ckan/package/dt=', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), '/run=', variables('runId'))",
                "type": "Expression"
              },
              "file": "package.json"
            }
          },
          "firstRowOnly": true
        }
      },
      {
        "name": "ReadColumns",
        "type": "Lookup",
        "dependsOn": [
          {
            "activity": "CopyColumnsToLake",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:15:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "JsonSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings",
              "recursive": false
            },
            "formatSettings": {
              "type": "JsonReadSettings"
            }
          },
          "dataset": {
            "referenceName": "ds_lake_json",
            "type": "DatasetReference",
            "parameters": {
              "folder": {
                "value": "@concat('ckan/datastore/dt=', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), '/run=', variables('runId'))",
                "type": "Expression"
              },
              "file": "fields.json"
            }
          },
          "firstRowOnly": true
        }
      },
      {
        "name": "CleanCheckMergeGold",
        "type": "SqlServerStoredProcedure",
        "dependsOn": [
          {
            "activity": "CopyRowsToSilver",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "ReadPackage",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "ReadColumns",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:15:00",
          "retry": 0,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "linkedServiceName": {
          "referenceName": "ls_sql_gold",
          "type": "LinkedServiceReference"
        },
        "typeProperties": {
          "storedProcedureName": "[gold].[usp_refresh_catalog]",
          "storedProcedureParameters": {
            "run_id": {
              "value": {
                "value": "@variables('runId')",
                "type": "Expression"
              },
              "type": "String"
            },
            "package_json": {
              "value": {
                "value": "@string(activity('ReadPackage').output.firstRow)",
                "type": "Expression"
              },
              "type": "String"
            },
            "fields_json": {
              "value": {
                "value": "@string(activity('ReadColumns').output.firstRow)",
                "type": "Expression"
              },
              "type": "String"
            },
            "resource_id": {
              "value": {
                "value": "@pipeline().parameters.resourceId",
                "type": "Expression"
              },
              "type": "String"
            },
            "pipeline_run": {
              "value": {
                "value": "@pipeline().RunId",
                "type": "Expression"
              },
              "type": "String"
            }
          }
        }
      }
    ],
    "parameters": {
      "datasetName": {
        "type": "string",
        "defaultValue": "flydata"
      },
      "resourceId": {
        "type": "string",
        "defaultValue": "e83f763b-b7d7-479e-b172-ae981ddc6de5"
      },
      "pageSize": {
        "type": "int",
        "defaultValue": 1000
      }
    },
    "variables": {
      "runId": {
        "type": "String"
      }
    },
    "folder": {
      "name": "catalog"
    },
    "annotations": []
  }
}
