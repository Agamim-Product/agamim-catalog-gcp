# catalog-refresh-${env}: one refresh of the catalog, started by Cloud Scheduler every 30 minutes.
#   1. run the ingest job (CKAN -> bronze) with a fresh RUN_ID
#   2. run the transform job (Dataform: bronze -> silver -> gold) for that RUN_ID
#   3. write _state/gold_ready.json, which tells the API to reload
# If a step fails, the later steps do not run, gold keeps its last good state, and the failure is logged
# (an alert policy watches failed executions).
main:
  params: [args]
  steps:
    - init:
        assign:
          - project: ${project}
          - location: ${region}
          - now: $${time.format(sys.now())}
          - run_id: $${text.replace_all(text.replace_all(text.substring(now, 0, 19), "-", ""), ":", "") + "Z"}
    - refresh:
        try:
          steps:
            - ingest:
                call: googleapis.run.v2.projects.locations.jobs.run
                args:
                  name: $${"projects/" + project + "/locations/" + location + "/jobs/${ingest_job}"}
                  body:
                    overrides:
                      containerOverrides:
                        - env:
                            - name: RUN_ID
                              value: $${run_id}
                  connector_params:
                    timeout: 1800
            - transform:
                call: googleapis.run.v2.projects.locations.jobs.run
                args:
                  name: $${"projects/" + project + "/locations/" + location + "/jobs/${transform_job}"}
                  body:
                    overrides:
                      containerOverrides:
                        - env:
                            - name: RUN_ID
                              value: $${run_id}
                  connector_params:
                    timeout: 1800
            - mark_gold_ready:
                call: googleapis.storage.v1.objects.insert
                args:
                  bucket: ${bucket}
                  name: ${ready_marker}
                  uploadType: media
                  body:
                    run_id: $${run_id}
                    finished_at: $${time.format(sys.now())}
            - log_success:
                call: sys.log
                args:
                  severity: INFO
                  json:
                    message: catalog refresh succeeded
                    env: ${env}
                    run_id: $${run_id}
        except:
          as: e
          steps:
            - log_failure:
                call: sys.log
                args:
                  severity: ERROR
                  json:
                    message: catalog refresh failed
                    env: ${env}
                    run_id: $${run_id}
                    error: $${e}
            - fail:
                raise: $${e}
    - done:
        return:
          run_id: $${run_id}
